# Copy to .env and adjust as needed. .env is git-ignored.
# Every value is optional; the defaults below target the public Honebi demo store.

# Application under test
BASE_URL=https://demo.honebi.online

# Your own mobile number for `npm run auth:login` (signed-in tests). Set it from the dashboard's Settings page
# or here; then only the OTP has to be typed. Never commit a real number: .env is git-ignored, this file is not.
# DEMO_MOBILE=

# Delivery location saved before each test so "Add to bag" never stops for the location dialog
DEMO_PINCODE=560001
DEMO_LATITUDE=12.9716
DEMO_LONGITUDE=77.5946

# Browsers to run (comma-separated): chrome, firefox, webkit, or "all". Default: chrome (Google Chrome)
BROWSERS=chrome
# Shortcut for chrome,firefox,webkit (ignored when BROWSERS is set)
CROSS_BROWSER=false

# Browser size, and the size of failed tests' screenshots and videos: 720p (1280x720), 1080p (1920x1080, default) or 1440p (2560x1440, 2K)
RECORDING_RESOLUTION=1080p
